{
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "max-len": [2, 250, 8, { "ignoreUrls": true }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-underscore-dangle": [2, { "allow": ["_id", "__"] }],
    "object-shorthand": 0,
    "func-names": 0,
    "no-param-reassign": 0,
    "linebreak-style": 0,
    "no-console": 0
  },
  "env": {
    "es6": true
  }
}
