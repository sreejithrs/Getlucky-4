<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Getlucky4</title>
    <meta name="description" content="Getlucky4">
    <meta name="keywords" content="">

</head>

<body class="tickets-bg"
    style="background-image: -webkit-linear-gradient(-45deg, #0e3b69 0, #0268b0 100%);min-height: auto;font-family: Poppins, sans-serif !important;">
    <input type="hidden" id="barcodeid" value="KT1260">
    <div class="table5" style="display: table;width: 100%;height: 100%;">
        <div class="table-cell" style="display: table-cell;vertical-align: middle;">
            <div id="ticket" style="background: #fff;height: auto;margin: 10px auto;">
                <div id="ticket-download">
                    <div class="row perforated first"
                        style="position: relative;border-bottom: 1px dashed #ddd;padding: 8px;">
                        <img src="<%= url %>/logo.jpg" class="round-mask" alt="logo"
                            style="width: 50px;margin-left: 10px;margin-top: 5px;height: auto;background: white;border-radius: 50%;">
                        <h2
                            style="display: inline-block; vertical-align: middle; padding-left: 10px; margin-top: -20px;">
                            Getlucky4</h2>
                    </div>
                    <div class="row text-center perforated destinations"
                        style="position: relative;text-align: center;padding-top: 12px;border-bottom: 1px dashed #ddd;padding: 8px;">
                        <div class="row text-center perforated destinations"
                            style="position: relative;text-align: center;padding-top: 12px;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <p style="font-size: 20px !important;margin: 0;padding-left: 9px;">Ticket Details</p>
                        </div>
                        <div class="row perforated destinations"
                            style="position: relative;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <div class="left" style="float: left;text-align: left;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Customer Name</div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">
                                    <%= name %>
                                </div>
                            </div>
                            <div class="right" style="float: right;text-align: right;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Mobile No. </div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">
                                    +<%= phoneNumber %>
                                </div>
                            </div>
                        </div>
                        <div class="row text-center perforated destinations"
                            style="position: relative;text-align: center;padding-top: 12px;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <p style="font-size: 15px !important;margin: 0;padding-left: 9px;">
                                <%= drawName %>
                            </p>
                        </div>
                        <div class="row perforated destinations"
                            style="position: relative;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <div class="left" style="float: left;text-align: left;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Grand Prize</div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">AED
                                    10,000.00
                                </div>
                            </div>
                            <div class="right" style="float: right;text-align: right;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Purchase Date</div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">
                                    <%= purchaseDate %>
                                </div>
                            </div>
                        </div>
                        <div class="row perforated destinations"
                            style="position: relative;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <div class="prize-total">
                                <p style="margin: 0;padding-left: 9px;">Getlucky4 Prizes</p>
                                <div style="margin-top: 10px;display: inline-flex;" class="row justify-content-center">
                                    <div class="col-md-4 pd-10" style="padding-right: 20px;">
                                        <div class="label"
                                            style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                            Straight</div>
                                        <div class=" city" style="text-transform: uppercase;font-size: 12px;">
                                            AED
                                            3,000.00</div>
                                    </div>
                                    <div class="col-md-4 pd-10" style="padding-right: 20px;">
                                        <div class="label"
                                            style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                            Rumble</div>
                                        <div class="city" style="text-transform: uppercase;font-size: 12px;">AED
                                            1,000.00</div>
                                    </div>
                                    <div class="col-md-4 pd-20">
                                        <div class="label"
                                            style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                            Chance</div>
                                        <div class="city" style="text-transform: uppercase;font-size: 12px;">AED
                                            100.00
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row perforated destinations"
                            style="position: relative;border-bottom: 1px dashed #ddd;padding: 8px;">
                            <div class="left" style="float: left;text-align: left;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Total Items</div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">
                                    <%= totalCount %>
                                </div>
                            </div>
                            <div class="right" style="float: right;text-align: right;">
                                <div class="label"
                                    style="text-transform: uppercase;font-size: 12px;font-weight: 700;margin-top: 10px;line-height: 1.2 !important;">
                                    Total Cost</div>
                                <div class="city" style="text-transform: uppercase;font-size: 12px;">
                                    <%= totalCost %>.00 AED
                                </div>
                            </div>
                        </div>
                        <div class="row perforated destinations justify-content-center"
                            style="position: relative;display: inline-flex;border-bottom: 1px dashed #ddd;padding: 8px;">

                            <table style="font-size: 12px;">
                                <tbody>
                                    <tr>
                                        <th style="text-align: center;padding: 8px;">Products</th>
                                        <th style="padding: 8px;">Quantity</th>
                                        <th style="padding: 8px;">Tickets</th>
                                        <th style="padding: 8px;">Raffle ID</th>
                                    </tr>
                                    <% for (let i=0; i < products.length; i++) { %>
                                        <tr>
                                            <td style="text-align: center;padding: 8px;">
                                                <%= products[i].productName %>
                                            </td>
                                            <td style="text-align: center;padding: 8px;">
                                                <%= products[i].quantity %>
                                            </td>
                                            <td style="text-align: center;padding: 8px;">
                                                <% let ticketNumbers=Array.isArray(products[i].tickets) ?
                                                    products[i].tickets.join(', ') : ''; %>
                                                <%= ticketNumbers %>
                                            </td>
                                            <td style="text-align: center;padding: 8px;">
                                                                <%= products[i].raffleId %>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                                            </div>
                                            <div class="row">
                                                <div class="row text-center"
                                                    style="text-align: center;padding-top: 12px;">
                                                    <p style="margin: 0;padding-left: 9px;"><b>Ticket ID: </b>
                                                        <%= ticketId %> </p>
                                                </div>
                                            </div>
                                            <div style="margin-top: 10px;margin-bottom: 15px;text-align: center;padding-top: 12px;"
                                                class="row text-center">
                                                <div class="terms-footer" style="font-size: 11px;font-weight: 500;">
                                                    <strong>All
                                                        Other
                                                        Terms
                                                        and Conditions Apply</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <table cellspacing="0" cellpadding="0" border="0" align="center" style="width: 100%; max-width: 600px;">
                                        <tr>
                                            <td align="center" style="padding: 15px;">
                                                <table cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
                                                    <tr>
                                                        <td align="center">
                                                            <a href="<%= link %>" style="color: white;text-decoration: none;display: inline-block;border-radius: 15px;background-color: rgb(18, 179, 18);padding: 8px 20px;margin-right: 10px;">Go to Website</a>
                                                        </td>
                                                        <td align="center">
                                                            <a href="<%= ticketDownload %>" style="color: white;text-decoration: none;display: inline-block;border-radius: 15px;background-color: #007bff;padding: 8px 20px;margin-right: 10px;">Download Ticket</a>
                                                        </td>
                                                        <td align="center">
                                                            <a href="<%= pdfDownload %>" style="color: white;text-decoration: none;display: inline-block;border-radius: 15px;background-color: rgb(255, 0, 0);padding: 8px 20px;">Download Invoice</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>                           
                                </div>
                            </div>
                        </div>

</body>

</html>