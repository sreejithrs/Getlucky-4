<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgotten Password</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.1);
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo {
            width: 40px;
            height: auto;
        }

        .content {
            padding: 20px;
            border-top: 2px solid #e74c3c;
            border-bottom: 2px solid #e74c3c;
            background-color: #f6f6f6;
        }

        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #3498db;
            color: #ffffff;
            text-decoration: none;
            border-radius: 5px;
        }

        .note {
            font-size: 14px;
            color: #888888;
            margin-top: 10px;
        }

        .temp-password {
            margin-top: 20px;
            padding: 15px;
            background-color: #f9f9f9;
            border-radius: 5px;
            border: 1px solid #dddddd;
        }

        .temp-password strong {
            color: #e74c3c;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            color: #888888;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <img src="<%= url %>/logo.jpg" alt="logo" class="logo">
            <h1>Forgot Your Password?</h1>
            <p>No worries, we've got you covered!</p>
        </div>
        <div class="content">
            <p class="note">Please do not reply to this email.</p>
            <div class="temp-password">
                <p></p>
                <p> Hi <%= name %>, Please use the otp to update your email.<br><br>
                        <strong>
                            <%= otp %>
                        </strong><br><br>
                        If you have NOT requested this email, we strongly advise you to check who has access to your
                        email account.

            </div>
        </div>
        <div class="footer">
            <p>&copy; 2023 Getlucky4. All rights reserved.</p>
        </div>
    </div>
</body>

</html>